{
  "name": "motd-forge",
  "version": "0.1.0",
  "description": "Generate a randomized login banner (MOTD) with system stats and a quote.",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "bin": {
    "motd-forge": "bin/motd-forge.js"
  },
  "main": "./src/index.js",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov",
    "start": "node bin/motd-forge.js",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "motd",
    "banner",
    "cli",
    "homelab",
    "sysadmin",
    "login"
  ],
  "author": "Zach Schneider <zachschneider@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkm/motd-forge.git"
  },
  "homepage": "https://github.com/zkm/motd-forge",
  "bugs": {
    "url": "https://github.com/zkm/motd-forge/issues"
  },
  "dependencies": {
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5"
  }
}
